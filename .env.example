# URL base da API (ver ADR-03). TanStack Start expõe ao navegador só
# variáveis prefixadas VITE_, igual a qualquer app Vite.
#
# Dev local (backend rodando com `uvicorn app.main:app --reload`):
VITE_API_URL=http://localhost:8000

# Produção (Fly.io) — confira o domínio real no painel antes de publicar:
# VITE_API_URL=https://planejamento-financeiro.fly.dev
